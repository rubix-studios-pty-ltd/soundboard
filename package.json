{
  "name": "soundboard",
  "version": "3.18.2",
  "description": "A feature-rich desktop soundboard application built with Electron and React for managing and playing sound effects.",
  "type": "module",
  "main": "dist/main.cjs",
  "scripts": {
    "release": "semantic-release",
    "dev": "cross-env NODE_ENV=development concurrently \"pnpm run watch:app\" \"pnpm run watch:css\" \"pnpm run electron:dev\"",
    "electron:dev": "nodemon --watch dist --exec \"electron . --enable-logging\"",
    "start": "pnpm run clean && pnpm run build:prod && electron .",
    "clean": "rimraf dist && rimraf release && pnpm exec biome check --write",
    "update": "pnpm update --latest && pnpm install && pnpm prune && pnpm dedupe",
    "build": "cross-env NODE_ENV=development pnpm run build:app && pnpm run build:css",
    "build:prod": "cross-env NODE_ENV=production pnpm run build:app && pnpm run build:css",
    "build:app": "node build.mjs",
    "build:css": "pnpx @tailwindcss/cli -i ./src/styles/tailwind.css -o ./dist/app/styles.css",
    "watch:app": "node build.mjs --watch",
    "watch:css": "pnpm exec tailwindcss -i ./src/styles/tailwind.css -o ./dist/app/styles.css --watch",
    "build:win": "pnpm run clean && cross-env NODE_ENV=production pnpm run build:prod && electron-builder --win portable --publish never",
    "build:mac:x64": "pnpm run clean && cross-env NODE_ENV=production pnpm run build:prod && electron-builder --mac --x64 --publish never",
    "build:mac:arm64": "pnpm run clean && cross-env NODE_ENV=production pnpm run build:prod && electron-builder --mac --arm64 --publish never"
  },
  "author": "Rubix Studios Pty. Ltd.",
  "license": "MIT",
  "devDependencies": {
    "@biomejs/biome": "2.4.14",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/github": "^12.0.8",
    "@tailwindcss/cli": "^4.3.0",
    "@tailwindcss/postcss": "^4.3.0",
    "@types/node": "^25.6.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "autoprefixer": "^10.5.0",
    "clsx": "^2.1.1",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "electron": "^42.0.1",
    "electron-builder": "^26.8.1",
    "esbuild": "^0.28.0",
    "fs-extra": "^11.3.5",
    "nodemon": "^3.1.14",
    "postcss": "^8.5.14",
    "rimraf": "^6.1.3",
    "semantic-release": "^25.0.3",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.3.0",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-radio-group": "^1.3.8",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slider": "^1.3.6",
    "@radix-ui/react-slot": "^1.2.4",
    "electron-store": "^11.0.2",
    "fluent-ffmpeg": "^2.1.3",
    "react": "^19.2.6",
    "react-dom": "^19.2.6"
  },
  "engines": {
    "node": ">=24 <25",
    "pnpm": ">=10"
  },
  "build": {
    "appId": "com.rubixstudios.soundboard",
    "productName": "Soundboard",
    "compression": "maximum",
    "win": {
      "target": "portable",
      "icon": "icon.ico",
      "artifactName": "Soundboard.exe",
      "extraResources": [
        {
          "from": "src/vendor/ffmpeg/win32",
          "to": "ffmpeg/win32",
          "filter": [
            "**/*"
          ]
        }
      ]
    },
    "mac": {
      "target": "dmg",
      "icon": "icon.icns",
      "category": "public.app-category.utilities",
      "artifactName": "Soundboard-${arch}.${ext}",
      "extraResources": [
        {
          "from": "src/vendor/ffmpeg/darwin-arm64",
          "to": "ffmpeg/darwin-arm64",
          "filter": [
            "**/*"
          ]
        },
        {
          "from": "src/vendor/ffmpeg/darwin-x64",
          "to": "ffmpeg/darwin-x64",
          "filter": [
            "**/*"
          ]
        }
      ]
    },
    "dmg": {
      "format": "UDZO"
    },
    "asar": true,
    "files": [
      "dist/**/*",
      "icon.ico",
      "index.html",
      "popout.html",
      "sound/**/*",
      "!**/release/**/*",
      "!**/screenshot/**/*",
      "!**/node_modules/*/{CHANGELOG.md,README.md,README,readme.md,readme}",
      "!**/node_modules/*/{test,__tests__,tests,powered-test,example,examples}",
      "!**/node_modules/*.d.ts",
      "!**/node_modules/.bin",
      "!**/*.{iml,o,hprof,orig,pyc,pyo,rbc,swp,csproj,sln,xproj}",
      "!.editorconfig",
      "!**/._*",
      "!**/{.DS_Store,.git,.hg,.svn,CVS,RCS,SCCS,.gitignore,.gitattributes}",
      "!**/{__pycache__,thumbs.db,.flowconfig,.idea,.vs,.nyc_output}",
      "!**/{appveyor.yml,.travis.yml,circle.yml}",
      "!**/{npm-debug.log,yarn.lock,.yarn-integrity,.yarn-metadata.json}",
      "!**/{package-lock.json,package.json,.npmrc,.yarnrc,.yarnclean}"
    ],
    "directories": {
      "output": "release"
    }
  },
  "packageManager": "pnpm@11.0.9"
}
